msgid "Disconnect"
msgstr "Rozłącz"

#: app/src/screens/connection.rs
msgid "Disconnecting"
msgstr "Rozłączanie"

#: app/src/screens/connection.rs app/src/screens/library.rs
msgid "None"
msgstr "Brak"

#: app/src/screens/connection.rs
msgid "{count} header"
msgid_plural "{count} headers"
msgstr[0] "{count} nagłówek"
msgstr[1] "{count} nagłówki"
msgstr[2] "{count} nagłówków"

#: app/src/screens/connection.rs app/src/screens/settings.rs
#: app/src/screens/welcome.rs
msgid "Cancel"
msgstr "Anuluj"

#: app/src/screens/connection.rs
msgid "Save"
msgstr "Zapisz"

#: app/src/screens/connection.rs
msgid ""
"Specify headers for server connections — one \"Name: Value\" pair per line. "
"They're attached to every request to this server."
msgstr ""
"Podaj nagłówki HTTP dla połączeń z serwerem — jedna para „Nazwa: Wartość” w "
"wierszu. Są dołączane do każdego zapytania wysyłanego do tego serwera."

#: app/src/screens/connection.rs
msgid "Choose a certificate file first."
msgstr "Najpierw wybierz plik z certyfikatem."

