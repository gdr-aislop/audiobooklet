msgid "Disconnect from the Server"
msgstr "Rozłącz z serwerem"

#: app/src/screens/connection.rs
msgid "Disconnect from {host}?"
msgstr "Rozłączyć z {host}?"

#. TRANSLATORS: Dialog body. {username} is the account being signed out.
#: app/src/screens/connection.rs app/src/screens/settings.rs
msgid ""
"{username}'s listening progress and bookmarks stored on this device will be "
"removed — everything on the server stays where it is."
msgstr ""
"Postęp słuchania i zakładki użytkownika {username} zapisane na tym "
"urządzeniu zostaną usunięte — wszystko na serwerze pozostanie bez zmian."

